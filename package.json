      "buildResources": "static"
    }
  },
  "scripts": {
    "dev": "nuxt",
    "build": "cross-env SALESFORCE_SERVICE_API=https://lit-woodland-26437.herokuapp.com SALESFORCE_API_VERSION=48.0 SALESFORCE_CLIENT_ID=3MVG9wEVwV0C9ejBn9DRxxqmoBQXhNtiWh3XndwUCv6mVzBnaSmpaAVWa9QPf61OnYtsXsMafBAbeTYV.yXJI SALESFORCE_SCOPES=full SALESFORCE_ENV=https://login.salesforce.com REDIRECT_CALLBACK=https://lit-woodland-26437.herokuapp.com/api/oauth2/callback nuxt build",
    "start": "nuxt start",
    "generate": "cross-env SALESFORCE_SERVICE_API=https://lit-woodland-26437.herokuapp.com SALESFORCE_API_VERSION=48.0 SALESFORCE_CLIENT_ID=3MVG9wEVwV0C9ejBn9DRxxqmoBQXhNtiWh3XndwUCv6mVzBnaSmpaAVWa9QPf61OnYtsXsMafBAbeTYV.yXJI SALESFORCE_SCOPES=full SALESFORCE_ENV=https://login.salesforce.com REDIRECT_CALLBACK=https://lit-woodland-26437.herokuapp.com/api/oauth2/callback nuxt generate",
